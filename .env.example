# ============================================
# PLANDING — AI Provider Configuration
# ============================================

# === CHỌN PROVIDER (bắt buộc) ===
# Giá trị hợp lệ: gemini | openai | anthropic | groq | deepseek
VITE_AI_PROVIDER=gemini

# === NGÔN NGỮ (mặc định: vi) ===
# Giá trị hợp lệ: vi | en
VITE_LANGUAGE=vi

# === GOOGLE GEMINI ===
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.6-flash

# === OPENAI ===
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_OPENAI_MODEL=gpt-4o

# === ANTHROPIC CLAUDE ===
# Lưu ý: Anthropic API có CORS policy khi gọi từ browser.
# Bạn có thể dùng proxy hoặc set VITE_ANTHROPIC_BASE_URL.
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# VITE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# === GROQ ===
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# === DEEPSEEK ===
# VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
# VITE_DEEPSEEK_MODEL=deepseek-chat
